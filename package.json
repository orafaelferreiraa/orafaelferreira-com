{
  "name": "orafaelferreira-com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:talks": "node scripts/sync-talks-and-events.mjs",
    "schedule:generate": "node scripts/generate-event-schedule.mjs",
    "rss:generate": "node scripts/generate-rss.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "llms:generate": "node scripts/generate-llms.mjs",
    "i18n:check": "node .claude/skills/i18n-parity/scripts/check-i18n-parity.mjs",
    "build": "npm run sync:talks && npm run rss:generate && npm run sitemap:generate && npm run llms:generate && vite build && npm run prerender",
    "build:spa": "npm run sync:talks && npm run rss:generate && npm run sitemap:generate && npm run llms:generate && vite build",
    "build:dev": "vite build --mode development",
    "prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest",
    "test:ci": "vitest --run --reporter=dot",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line",
    "serve:dist": "node scripts/serve-dist.mjs --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.9",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.17",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  }
}
