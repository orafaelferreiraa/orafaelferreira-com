.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Terraform local directories and files that should not be committed
.terraform/

# Local state files
*.tfstate
*.tfstate.*

# Plan files
*.tfplan

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config files (usually user-specific)
.terraformrc
terraform.rc

# Note: we intentionally do NOT ignore .terraform.lock.hcl
# It's recommended to commit the lock file for provider checksums.

# Azure MCP Server credentials (service principal secret) - never commit
.azure-mcp.env