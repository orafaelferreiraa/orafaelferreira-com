{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/api/*"
    ]
  },
  "routes": [
    {
      "route": "/artigos/*.html",
      "serve": "/artigos/*.html",
      "statusCode": 200,
      "methods": [
        "GET"
      ],
      "allowedRoles": []
    }
  ],
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Cache-Control": "public, max-age=3600"
  },
  "mimeTypes": {
    ".json": "application/json; charset=utf-8"
  }
}